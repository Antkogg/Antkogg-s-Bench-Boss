# Discord application credentials (never commit real values)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands instantly in one development guild
DISCORD_GUILD_ID=

# Neon PostgreSQL connection used by the bot and Prisma CLI
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Runtime
LOG_LEVEL=info
NODE_ENV=production
