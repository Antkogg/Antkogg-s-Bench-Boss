{
  "name": "antkoggs-bench-boss",
  "version": "1.0.0",
  "private": true,
  "description": "Discord-native LG CHEL scouting and management bot",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:install": "npm install --prefix tooling",
    "dev": "node tooling/node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "start": "node dist/index.js",
    "build": "node tooling/node_modules/prisma/build/index.js generate && node tooling/node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node tooling/node_modules/prisma/build/index.js generate && node tooling/node_modules/typescript/bin/tsc --noEmit",
    "lint": "node tooling/node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node tooling/node_modules/eslint/bin/eslint.js . --fix",
    "format": "node tooling/node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node tooling/node_modules/prettier/bin/prettier.cjs --check .",
    "test": "node tooling/node_modules/vitest/vitest.mjs run",
    "test:watch": "node tooling/node_modules/vitest/vitest.mjs",
    "commands:register": "node tooling/node_modules/tsx/dist/cli.mjs src/bot/register-commands.ts",
    "db:generate": "node tooling/node_modules/prisma/build/index.js generate",
    "db:migrate": "node tooling/node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node tooling/node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node tooling/node_modules/prisma/build/index.js db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.2",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "zod": "^4.1.5"
  }
}
