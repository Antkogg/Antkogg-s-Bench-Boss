{
  "name": "antkoggs-lg-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Discord-native LG CHEL scouting and management bot",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "install:production": "npm ci --omit=dev --omit=optional --legacy-peer-deps --ignore-scripts --no-fund --no-audit",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "commands:register": "tsx src/bot/register-commands.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.2",
    "luxon": "^3.7.2",
    "pino": "^9.9.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/luxon": "^3.7.4",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.10"
  }
}
